{
  "name": "slay-the-spire",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:browser": "tsc -p tsconfig.browser.json && playwright test",
    "check:assets": "node scripts/check-assets.mjs",
    "build:performance": "vite build --config vite.performance.config.ts",
    "test:performance": "tsc -p tsconfig.browser.json && npm run build && npm run build:performance && playwright test --config playwright.performance.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.5.2",
    "@types/seedrandom": "^3.0.8",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "seedrandom": "^3.0.5",
    "zod": "^4.1.11"
  }
}
